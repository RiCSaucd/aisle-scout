<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no Google Drive backup, so the list and pantry stay on the phone
     (see the privacy policy). Phone-to-phone transfer during setup is still allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
